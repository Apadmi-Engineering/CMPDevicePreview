#!/bin/sh
# Rejects a commit message that isn't a Conventional Commit. release-please builds the changelog
# and picks the next version from these messages.
#
# Install once per clone:  git config core.hooksPath .githooks

subject=$(grep -v '^#' "$1" | sed -n '/./{p;q;}')

# Nothing to check: git aborts an empty message itself.
[ -z "$subject" ] && exit 0

# Merges, reverts and autosquash commits are generated by git.
case "$subject" in
    "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|perf|revert|docs|style|chore|refactor|test|build|ci)(\([^)]+\))?!?: .+'; then
    exit 0
fi

cat >&2 <<EOF
Commit message rejected: "$subject"

Use the Conventional Commits format, type(scope): description

  feat: add a new device frame
  fix(sample): restore the installable Android app
  refactor!: describe devices in dp

Types: feat fix perf revert docs style chore refactor test build ci
Add ! after the type (or scope) for a breaking change.
See CONTRIBUTING.md.
EOF
exit 1
